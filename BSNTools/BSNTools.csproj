<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyVersion>0.0.0.74</AssemblyVersion>
		<FileVersion>0.0.0.74</FileVersion>
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="IPNetwork2" Version="3.4.851" />
		<PackageReference Include="Syncfusion.Core.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Edit.Windows" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Grid.Grouping.Windows" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Grid.Windows" Version="32.1.25" />
		<PackageReference Include="Syncfusion.GridHelperClasses.Windows" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Grouping.Base" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Office2016Theme.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Office2019Theme.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.SfDataGrid.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.SfInput.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.SfListView.WinForms" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Spreadsheet.Windows" Version="32.1.25" />
		<PackageReference Include="Syncfusion.Tools.Windows" Version="32.1.25" />
		<PackageReference Include="UnitsNet" Version="6.0.0-pre019" />
		<PackageReference Include="UnitsNet.NumberExtensions.CS14" Version="6.0.0-pre017" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="UI\Controls\" />
	</ItemGroup>

</Project>